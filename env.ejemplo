# PonchoStudio · copia este archivo como .env y llena lo que tengas.
# Sin llaves la app funciona en MODO DEMO (simula los trabajos).
# Nunca subas el .env a git ni compartas estas llaves.

# Seedance (video directo y barato). Sácala en BytePlus ModelArk:
# console.byteplus.com → ModelArk → API Keys. Activa Seedance 2.5 en la consola.
ARK_API_KEY=
# Región de ModelArk (normalmente no se toca)
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Seedream 5.5 (imágenes directas). Usa la misma ARK_API_KEY de arriba; actívalo en la consola de ModelArk.
# Model ID oficial (docs.byteplus.com → Seedream 5.5). Solo cámbialo si BytePlus publica uno nuevo.
SEEDREAM_MODEL=dola-seedream-5-5-261028

# OpenRouter (plan B de Seedance). Solo se usa si Seedance directo no está disponible
# (sin ARK_API_KEY o cuenta sin permiso). Llave en openrouter.ai → Keys. Cobra a su propio saldo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (imágenes y mejorar prompts). Es la llave de API de platform.openai.com → API keys,
# no la suscripción de ChatGPT.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Modelo de texto para mejorar prompts cuando Ollama no está
OPENAI_TEXT_MODEL=gpt-5-mini

# Ollama local (gratis). Instálalo desde ollama.com. Vacío = usa el primer modelo que encuentre.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=

# Higgsfield por MCP. No lleva llave: se conecta con tu cuenta desde la app (botón Conectar).
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# Puerto local y carpeta de datos
PUERTO=8010
DATA_DIR=./data
